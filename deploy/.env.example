# 完整实验室请用 Compose 的 Postgres；本机单人开发才用 SQLite。
DATABASE_URL=sqlite+pysqlite:///./data/fengsuan.db
# REDIS_URL=redis://localhost:6379/0
SECRET_KEY=please-change-this-secret-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme1
FRONTEND_ORIGIN=http://localhost:5173
GPU_MODE=off
FILE_ROOT=data
# FENGSUN_SEED_GUIDE_LAB=1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@localhost
TAVILY_API_KEY=
BOCHA_API_KEY=
# 谷歌学术：有密钥时优先走 SerpApi，失败再走下面的海外代理。auto / serpapi / proxy。
FENGSUN_SCHOLAR_MODE=auto
FENGSUN_SERPAPI_KEY=
# 多个代理用逗号分开。支持 http 和 socks5。
FENGSUN_SCHOLAR_PROXY=
# OpenAlex / Unpaywall 要求的联系邮箱
FENGSUN_CONTACT_EMAIL=
S2_API_KEY=
CORE_API_KEY=
# 1 时把 MiniMax 原生联网放进对话主循环。检索工具本身总会优先用原生联网。
FENGSUN_NATIVE_WEB_LOOP=0
GROBID_URL=
# 体验实验室每月 token 上限，和正式实验室分开。
GUEST_MONTHLY_TOKEN_BUDGET=2000000
# 公网名字。把令牌写在服务器的 .env，不要提交。没有令牌就不要开 tunnel。
# 固定域名在 ngrok 后台领取后填到 NGROK_DOMAIN，例如 my-lab.ngrok-free.app
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
BACKUP_DIR=data/backups
