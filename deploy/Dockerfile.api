FROM python:3.12-slim
WORKDIR /app
COPY platform/requirements.txt /app/platform/requirements.txt
COPY platform/requirements-engine.txt /app/platform/requirements-engine.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r platform/requirements.txt -r platform/requirements-engine.txt
COPY modules/file1agent /app/modules/file1agent
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple /app/modules/file1agent
COPY . /app
ENV PYTHONPATH=/app:/app/platform
CMD ["uvicorn", "fengsuan.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
